# Serviço systemd do conector A7Pharma -> Foody.
# Instalação: ver deploy/linux/LEIAME.md
[Unit]
Description=Conector A7Pharma -> Foody Delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=a7foody
Group=a7foody
WorkingDirectory=/opt/a7foody-connector
ExecStart=/opt/a7foody-connector/A7FoodyConnector
Restart=always
RestartSec=30
Environment=DOTNET_ENVIRONMENT=Production
Environment=TZ=America/Sao_Paulo

# Endurecimento: só escreve na pasta de dados; nada de privilégios extras.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/a7foody-connector

[Install]
WantedBy=multi-user.target
