{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },

  "Foody": {
    "BaseUrl": "https://app.foodydelivery.com/rest/1.2/",
    "AttemptTimeout": "00:00:20"
  },

  "Sync": {
    "Interval": "00:00:30",
    "BatchSize": 50,
    "AutoCloseDelivered": true,
    "TrackingMaxAge": "2.00:00:00"
  },

  "Mapping": {
    "OrderIdFormat": "{sale}",
    "CreateAsReady": true,
    "DefaultPaymentMethod": null,
    "PaymentMethods": {
      "DINHEIRO": "Money",
      "CARTAO": "Card",
      "CARTAO CREDITO": "Card",
      "CARTAO DEBITO": "Card",
      "PIX": "Pix",
      "CONVENIO": "OnCredit",
      "CREDIARIO": "OnCredit",
      "ONLINE": "Online"
    }
  },

  "A7": {
    "ConnectionStrings": {},
    "SalesQueryFile": "sql/vendas-entrega.sql",
    "ItemsQueryFile": "sql/itens-venda.sql",
    "BatchSize": 200,
    "CommitLag": "00:00:10",
    "FirstRunLookback": "00:00:00",
    "DatabaseTimeZone": "America/Sao_Paulo"
  },

  "Stores": [
    {
      "StoreId": "1",
      "Name": "Matriz",
      "FoodyToken": "",
      "Enabled": false
    }
  ]
}
